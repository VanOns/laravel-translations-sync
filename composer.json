{
    "name": "van-ons/laravel-translations-sync",
    "description": "A package that synchronizes translations between your Laravel project and a provider.",
    "keywords": [
        "laravel",
        "translations",
        "sync"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Van Ons",
            "email": "opensource@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "google/apiclient": "^2.17",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check",
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "VanOns\\LaravelTranslationsSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\LaravelTranslationsSync\\LaravelTranslationsSyncServiceProvider"
            ],
            "aliases": {
                "LaravelTranslationsSync": "VanOns\\LaravelTranslationsSync\\Facades\\LaravelTranslationsSync"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
